@using PharmaAPIConsuming.DTO
@model UserDetailDTO
@{
    ViewData["Title"] = "Manage Users";
    Layout = "_Layout";
}



<link href="https://cdn.datatables.net/v/dt/jq-3.7.0/jszip-3.10.1/dt-2.3.2/af-2.7.0/b-3.2.3/b-colvis-3.2.3/b-html5-3.2.3/b-print-3.2.3/cr-2.1.1/cc-1.0.5/date-1.5.5/fc-5.0.4/fh-4.0.3/kt-2.12.1/r-3.0.4/rg-1.5.1/rr-1.5.0/sc-2.4.3/sb-1.8.2/sp-2.3.3/sl-3.0.1/sr-1.4.1/datatables.min.css" rel="stylesheet" integrity="sha384-COTvLrRQ3Wx22EXFNmowGpLebPP1VDKj36mmQ8tIHGMVfN9svObjBGSu/KyDhAXq" crossorigin="anonymous">




<h2>User Management</h2>
<button class="btn btn-primary mb-3" id="openModal">Add User</button>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>User ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>PasswordHash</th>
            <th>Role</th>
            <th>Branch</th>
            <th>Created By</th>
            <th>Created Date</th>
            <th>Updated By</th>
            <th>Updated At</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody id="userTableBody"></tbody>
</table>

<!-- Modal -->
<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="userForm">
                <div class="modal-header">
                    <h5 class="modal-title">Add / Edit User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="UserId" name="UserId" />
                    <div class="mb-3">
                        <label for="Username">Username</label>
                        <input type="text" id="Username" name="Username" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="UserEmail">Email</label>
                        <input type="email" id="UserEmail" name="UserEmail" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="PasswordHash">Password</label>
                        <input type="password" id="PasswordHash" name="PasswordHash" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="RoleId">Role</label>
                        <select id="RoleId" name="RoleId" class="form-control"></select>
                    </div>
                    <div class="mb-3">
                        <label for="BranchId">Branch</label>
                        <select id="BranchId" name="BranchId" class="form-control"></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" id="saveUserBtn">Save</button>
                    <button type="button" class="btn btn-success" id="updateUserBtn" style="display: none;">Update</button>

                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {



    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js" integrity="sha384-VFQrHzqBh5qiJIU0uGU5CIW3+OWpdGGJM9LBnGbuIH2mkICcFZ7lPd/AAtI7SNf7" crossorigin="anonymous"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js" integrity="sha384-/RlQG9uf0M2vcTw3CX7fbqgbj/h8wKxw7C3zu9/GxcBPRKOEcESxaxufwRXqzq6n" crossorigin="anonymous"></script>

    <script src="https://cdn.datatables.net/v/dt/jq-3.7.0/jszip-3.10.1/dt-2.3.2/af-2.7.0/b-3.2.3/b-colvis-3.2.3/b-html5-3.2.3/b-print-3.2.3/cr-2.1.1/cc-1.0.5/date-1.5.5/fc-5.0.4/fh-4.0.3/kt-2.12.1/r-3.0.4/rg-1.5.1/rr-1.5.0/sc-2.4.3/sb-1.8.2/sp-2.3.3/sl-3.0.1/sr-1.4.1/datatables.min.js"
            integrity="sha384-sk5ouhyMD++8NoW6ZZXMnaxpnEPUQPrlznUrRT+8CZZsq9FVzQL/OtIoM8oKoM6G"
            crossorigin="anonymous">
    </script>


    <script>
        $(document).ready(function () {
            $('.table').DataTable(); // Apply to your roles table
        });
    </script>


    <script>
        $(document).ready(function () {
            fetchUsers();
            loadDropdowns();

            $("#openModal").click(function () {
                resetForm();
                $("#userModal").modal("show");
                $("#saveUserBtn").show();
                $("#updateUserBtn").hide();
            });

            $("#saveUserBtn").click(function () {
                addUser();
            });

            $("#updateUserBtn").click(function () {
                updateUser();
            });
        });

        function addUser() {
            const userData = {
                Username: $("#Username").val(),
                UserEmail: $("#UserEmail").val(),
                PasswordHash: $("#PasswordHash").val(),
                RoleId: parseInt($("#RoleId").val()),
                BranchId: parseInt($("#BranchId").val()),
                CreatedBy: "Admin",
                UpdatedBy: "Admin"
            };

            $.ajax({
                url: "/Admin/AddUser",
                type: "POST",
                data: JSON.stringify(userData),
                contentType: "application/json",
                success: function () {
                    $("#userModal").modal("hide");
                    fetchUsers();
                },
                error: function (xhr) {
                    console.error("❌ Add User Error:", xhr.responseText);
                    alert("Failed to add user");
                }
            });
        }

                function updateUser() {
            const userId = parseInt($("#UserId").val()); 

            const userData = {
                // UserId: userId,
                UserId: parseInt($("#UserId").val()),
                Username: $("#Username").val(),
                UserEmail: $("#UserEmail").val(),
                PasswordHash: $("#PasswordHash").val(),
                RoleId: parseInt($("#RoleId").val()),
                BranchId: parseInt($("#BranchId").val()),
                UpdatedBy: "Admin"
                

            };

            $.ajax({
                url: "/Admin/UpdateUsers",
                type: "POST",              
                data: JSON.stringify(userData),
                contentType: "application/json",
                success: function () {
                    $("#userModal").modal("hide");
                    fetchUsers();
                },
                error: function (xhr) {
                    console.error("❌ Update User Error:", xhr.responseText);
                    alert("Failed to update user");
                }
            });
        }


        function fetchUsers() {
            $.get("/Admin/FetchUsers", function (data) {
                let html = "";
                $.each(data, function (i, user) {
                    html += `<tr>
                        <td>${user.userId}</td>
                        <td>${user.username}</td>
                        <td>${user.userEmail}</td>
                        <td>${user.passwordHash}</td>
                        <td>${user.roleName}</td>
                        <td>${user.branchName}</td>
                        <td>${user.createdBy}</td>
                        <td>${user.createdDate}</td>
                        <td>${user.updatedBy}</td>
                        <td>${user.updatedAt}</td>
                        <td>
                            <button class='btn btn-info btn-sm' onclick='editUser(${user.userId})'>Edit</button>
                            <button class='btn btn-danger btn-sm' onclick='deleteUser(${user.userId})'>Delete</button>
                        </td>
                    </tr>`;
                });
                $("#userTableBody").html(html);
            });
        }

        function editUser(id) {
            $.get(`/Admin/GetUserById?id=${id}`, function (user) {
                $("#UserId").val(user.userId);
                $("#Username").val(user.username);
                $("#UserEmail").val(user.userEmail);
                $("#PasswordHash").val(user.passwordHash);
                $("#RoleId").val(user.roleId);
                $("#BranchId").val(user.branchId);
                $("#userModal").modal("show");
                $("#saveUserBtn").hide();
                $("#updateUserBtn").show();
            });
        }

        function deleteUser(id) {
            if (confirm("Are you sure you want to delete this user?")) {
                $.get(`/Admin/DeleteUser?id=${id}`, function () {
                    fetchUsers();
                });
            }
        }

        function resetForm() {
            $("#userForm")[0].reset();
            $("#UserId").val("");
        }

        function loadDropdowns() {
            $.get("/Admin/FetchRoles", function (data) {
                let roleOptions = "";
                $.each(data, function (i, r) {
                    roleOptions += `<option value='${r.roleId}'>${r.roleName}</option>`;
                });
                $("#RoleId").html(roleOptions);
            });

            $.get("/Admin/FetchBranches", function (data) {
                let branchOptions = "";
                $.each(data, function (i, b) {
                    branchOptions += `<option value='${b.branchId}'>${b.branchName}</option>`;
                });
                $("#BranchId").html(branchOptions);
            });
        }
    </script>
}
