@section Scripts {
    <script>
        $(document).ready(function () {
            loadSuppliers();

            // Open modal for Add
            $("#openModal").click(function () {
                resetForm();
                $("#supplierModal").modal("show");
                $("#addSupplierBtn").show();
                $("#updateSupplierBtn").hide();
            });

            // Handle Add
            $("#addSupplierBtn").click(function () {
                var form = $("#supplierForm").serialize();

                $.ajax({
                    url: "/Admin/AddSupplier",
                    type: "POST",
                    data: form,
                    success: function () {
                        $("#supplierModal").modal("hide");
                        loadSuppliers();
                        resetForm();
                    },
                    error: function () {
                        alert("Error adding supplier");
                    }
                });
            });

            // Handle Update
            $("#updateSupplierBtn").click(function () {
                var form = $("#supplierForm").serialize();

                $.ajax({
                    url: "/Admin/UpdateSupplier",
                    type: "POST",
                    data: form,
                    success: function () {
                        $("#supplierModal").modal("hide");
                        loadSuppliers();
                        resetForm();
                    },
                    error: function () {
                        alert("Error updating supplier");
                    }
                });
            });
        });

        function resetForm() {
            $("#supplierForm")[0].reset();
            $("#SupplierId").val("");
            $("#addSupplierBtn").show();
            $("#updateSupplierBtn").hide();
        }

        function loadSuppliers() {
            $.ajax({
                url: "/Admin/FetchSuppliers",
                type: "GET",
                success: function (data) {
                    let html = "";
                    $.each(data, function (i, s) {
                        html += `<tr>
                            <td>${s.supplierId}</td>
                            <td>${s.name}</td>
                            <td>${s.contact}</td>
                            <td>${s.address}</td>
                            <td>
                                <button class="btn btn-info btn-sm" onclick="editSupplier(${s.supplierId})">Edit</button>
                                <button class="btn btn-danger btn-sm" onclick="deleteSupplier(${s.supplierId})">Delete</button>
                            </td>
                        </tr>`;
                    });
                    $("#supplierData").html(html);
                },
                error: function () {
                    alert("Error loading suppliers");
                }
            });
        }

        function editSupplier(id) {
            $.ajax({
                url: "/Admin/GetSupplierById?id=" + id,
                type: "GET",
                success: function (data) {
                    $("#SupplierId").val(data.supplierId);
                    $("#Name").val(data.name);
                    $("#Contact").val(data.contact);
                    $("#Address").val(data.address);

                    $("#supplierModal").modal("show");
                    $("#addSupplierBtn").hide();
                    $("#updateSupplierBtn").show();
                },
                error: function () {
                    alert("Failed to load supplier");
                }
            });
        }

        function deleteSupplier(id) {
            if (confirm("Are you sure you want to delete this supplier?")) {
                $.ajax({
                    url: "/Admin/DeleteSupplier?id=" + id,
                    type: "GET",
                    success: function () {
                        loadSuppliers();
                    },
                    error: function () {
                        alert("Error deleting supplier");
                    }
                });
            }
        }
    </script>
}
