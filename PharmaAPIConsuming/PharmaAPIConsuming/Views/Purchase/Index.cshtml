@model List<PharmaAPIConsuming.Models.PurchaseReadDTO>
@{
    ViewBag.Title = "Purchase List";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">
    <h2>Purchase List</h2>
    <a href="/Purchase/Add" class="btn btn-success mb-3">+ Add New</a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Invoice No</th>
                <th>Total Amount</th>
                <th>Supplier</th>
                <th>Branch</th>
                <th>Purchase Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PurchaseId</td>
                    <td>@item.InvoiceNo</td>
                    <td>@item.TotalAmount</td>
                    <td>@item.SupplierName</td>
                    <td>@item.BranchName</td>
                    <td>@item.PurchaseDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a href="/Purchase/Edit/@item.PurchaseId" class="btn btn-warning btn-sm">Edit</a>
                        <a href="/Purchase/Delete/@item.PurchaseId" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
