@model List<PharmaAPIConsuming.DTO.MedicineReadDTO>
@{
    Layout = "_Layout";
}

<!---------------------------------- CSS Links ----------------------------------------->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />

<!--------------------------------------main------------------------------------------>
<h2 class="text-center mb-4">💊 💉 🩺 🏥 Medicine Management ⚕️🧪 🧬 🧻</h2>

<div class="container">

    <!--Add Button-->
    <button type="button" id="addbtn" class="btn btn-primary mb-3">
        Add Medicine <i class="bi bi-plus-circle"></i>
    </button>

    <!-- Table -->
    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Category</th>
                <th>GST Rate (%)</th>
                <th>Created By</th>
                <th>Created At</th>
                <th>Updated By</th>
                <th>Updated At</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="medicineTable">
            @foreach (var med in Model)
            {
                <tr>
                    <td>@med.MedicineId</td>
                    <td>@med.Name</td>
                    <td>@med.Category</td>
                    <td>@med.GSTRate</td>
                    <td>@med.CreatedBy</td>
                    <td>@med.CreatedAt</td>
                    <td>@med.UpdatedBy</td>
                    <td>@med.UpdatedAt</td>
                    <td>
                        <button class="btn btn-sm btn-info text-white" onclick="editMedicine(@med.MedicineId)">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-sm btn-danger" onclick="deleteMedicine(@med.MedicineId)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="medicineForm" novalidate>

                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Enter Medicine Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="MedicineId" name="MedicineId" />
                    <div class="mb-3">
                        <label for="Name" class="form-label">Name</label>
                        <input type="text" id="Name" name="Name" class="form-control" required maxlength="50"/>
                    </div>
                    <div class="mb-3">
                        <label for="Category" class="form-label">Category</label>
                        <input type="text" id="Category" name="Category" class="form-control" required maxlength="50"/>
                    </div>
                    <div class="mb-3">
                        <label for="GSTRate" class="form-label">GST Rate (%)</label>
                        <input type="number" id="GSTRate" name="GSTRate" class="form-control" step="0.01" required  min="0" max="100"/>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="savebtn" class="btn btn-primary">Save</button>
                </div>

            </form>
        </div>
    </div>
</div>

<!----------------------------------- JS Links ----------------------------------->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js">
    </script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<!--inbuild js-->
<script src="~/js/medicine.js"></script>
