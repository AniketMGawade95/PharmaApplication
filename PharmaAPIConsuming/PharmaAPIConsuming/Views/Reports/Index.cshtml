@model PharmaAPIConsuming.Models.DashboardViewModel

@{
    ViewData["Title"] = "Pharma Dashboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container py-5">
    <h2 class="text-center text-primary fw-bold mb-5">Pharma Reports Dashboard</h2>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <!-- Stat Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card text-white bg-warning shadow-sm rounded-4 h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Stock Alert</h5>
                    <p class="display-6 fw-bold">@Model?.StockAlertCount</p>
                    <small class="text-light">Items below stock threshold</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-danger shadow-sm rounded-4 h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Expiry Alert</h5>
                    <p class="display-6 fw-bold">@Model?.ExpiryAlertCount</p>
                    <small class="text-light">Items expiring soon</small>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-success shadow-sm rounded-4 h-100">
                <div class="card-body text-center">
                    <h5 class="card-title">Total Sales Today</h5>
                    <p class="display-6 fw-bold">
                        @(
                            Model?.TodaySales != null
                            ? Model.TodaySales.Sum(s => s.TotalPrice)
                            : 0
                            ).ToString("C")
                    </p>
                    <small class="text-light">₹ Total sales amount</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Today's Sales Table -->
    <div class="mb-5">
        <div class="card shadow-sm rounded-4">
            <div class="card-body">
                <h4 class="mb-3 text-secondary fw-bold">Today's Sales</h4>
                @if (Model?.AllSales != null && Model.AllSales.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Sale Date</th>
                                    <th>Medicine</th>
                                    <th>Quantity</th>
                                    <th>Discount (%)</th>
                                    <th>Total Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sale in Model.AllSales)
                                {
                                    <tr>
                                        <td>@sale.SaleDate?.ToShortDateString()</td>
                                        <td>@sale.MedicineName</td>
                                        <td>@sale.Quantity</td>
                                        <td>@sale.Discount.ToString("0.##")</td>
                                        <td>@sale.TotalPrice.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No sales data available.</p>
                }
            </div>
        </div>
    </div>

    <!-- Top 5 Medicines -->
    <div class="mb-5">
        <div class="card shadow-sm rounded-4">
            <div class="card-body">
                <h4 class="mb-3 text-secondary fw-bold">Top 5 Medicines Sold</h4>
                @if (Model?.Top5Medicines != null && Model.Top5Medicines.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Medicine</th>
                                    <th>Quantity Sold</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Top5Medicines)
                                {
                                    <tr>
                                        <td>@item.MedicineName</td>
                                        <td>@item.Quantity</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No top medicines data available.</p>
                }
            </div>
        </div>
    </div>

    <!-- Monthly Sales Chart -->
    <div class="mb-5">
        <div class="card shadow-sm rounded-4">
            <div class="card-body">
                <h4 class="text-center text-primary fw-bold mb-4">Monthly Sales Bar Chart</h4>
                <canvas id="monthlySalesChart" height="100"></canvas>
            </div>
        </div>
    </div>
</div>

<script>
    window.onload = function () {
        fetch('/Reports/GetMonthlySalesData')
            .then(res => {
                if (!res.ok) throw new Error('Network response was not ok');
                return res.json();
            })
            .then(data => {
                const labels = data.map(item => item.month);
                const values = data.map(item => item.totalSales);

                const ctx = document.getElementById('monthlySalesChart').getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Total Sales (₹)',
                            data: values,
                            backgroundColor: '#0d6efd',
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    stepSize: 500
                                }
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            title: {
                                display: true,
                                text: 'Monthly Sales in ₹',
                                font: { size: 16 }
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return '₹ ' + context.parsed.y.toLocaleString();
                                    }
                                }
                            }
                        }
                    }
                });
            })
            .catch(error => {
                console.error("Chart loading failed:", error);
                alert("Failed to fetch sales chart data.");
            });
    };
</script>
