@using PharmaAPIConsuming.DTO
@model List<PharmaAPIConsuming.DTO.PurchaseItemReadDTO>

@{
    ViewBag.Title = "Purchase Items";
}

<!-- Bootstrap CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">📦 Purchase Items</h2>
        <a href="/PurchaseItem/Add" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New Item
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table class="table table-hover table-striped align-middle text-center">
                <thead class="table-primary">
                    <tr>
                        <th>#</th>
                        <th>Medicine</th>
                        <th>Quantity</th>
                        <th>Rate</th>
                        <th>Branch</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.PurchaseItemId</td>
                            <td>@item.MedicineName</td>
                            <td>@item.Quantity</td>
                            <td>@item.Rate</td>
                            <td>@item.BranchName</td>
                            <td>
                                <a href="/PurchaseItem/Edit/@item.PurchaseItemId" class="btn btn-warning btn-sm me-2">
                                    ✏️ Edit
                                </a>
                                <a href="/PurchaseItem/Delete/@item.PurchaseItemId"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Are you sure you want to delete this item?');">
                                    🗑️ Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-info mt-3 text-center">
                    No purchase items found.
                </div>
            }
        </div>
    </div>
</div>

<!-- Optionally add Bootstrap icons -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.js"></script>
