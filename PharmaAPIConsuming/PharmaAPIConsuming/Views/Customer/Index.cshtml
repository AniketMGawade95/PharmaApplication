@model IEnumerable<PharmaAPIConsuming.DTO.CustomerDTO>

@{
    ViewData["Title"] = "Customer List";
}

<div class="container mt-4">
    <h2 class="mb-3">📋 Customer List</h2>
    <div class="mb-3">
        <a asp-action="AddCustomer" class="btn btn-success">➕ Add New</a>
        <a asp-action="SalesHistory" class="btn btn-info ms-2">📊 View Sales History</a>
    </div>

    <table class="table table-hover table-bordered text-center align-middle">
        <thead class="table-dark">
            <tr>
                <th>Customer ID</th>
                <th>Name</th>
                <th>Mobile</th>
                <th>Address</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CustomerId</td>
                    <td>@item.Name</td>
                    <td>@item.Mobile</td>
                    <td>@item.Address</td>
                    <td>
                        <a asp-action="EditCustomer" asp-route-id="@item.CustomerId" class="btn btn-sm btn-primary">✏️ Edit</a>
                        <a asp-action="GetCustomer" asp-route-id="@item.CustomerId" class="btn btn-sm btn-secondary">🔍 View</a>
                        <form asp-action="DeleteCustomer" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@item.CustomerId" />
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">🗑️ Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
