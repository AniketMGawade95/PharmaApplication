@model List<PharmaAPIConsuming.DTO.PurchaseHistoryDTO>

@{
    ViewBag.Title = "Sales History";
}

<h2>Sales History</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Customer Name</th>
            <th>Mobile</th>
            <th>Medicine Name</th>
            <th>Quantity</th>
            <th>Discount</th>
            <th>Total Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CustomerName</td>
                <td>@item.Mobile</td>
                <td>@item.MedicineName</td>
                <td>@item.Quantity</td>
                <td>@item.Discount</td>
                <td>@item.TotalAmount</td>
            </tr>
        }
    </tbody>
</table>

<a class="btn btn-secondary" href="@Url.Action("Index")">Back to Customers</a>
