@model PharmaAPIConsuming.DTO.CustomerDTO

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-4 border-0">
                <div class="card-header bg-info text-white rounded-top-4">
                    <h3 class="mb-0 text-center">Customer Details</h3>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 fw-bold">Customer ID</dt>
                        <dd class="col-sm-8">@Model.CustomerId</dd>

                        <dt class="col-sm-4 fw-bold">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4 fw-bold">Mobile</dt>
                        <dd class="col-sm-8">@Model.Mobile</dd>

                        <dt class="col-sm-4 fw-bold">Address</dt>
                        <dd class="col-sm-8">@Model.Address</dd>
                    </dl>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3 mt-4">
                <a asp-action="EditCustomer" asp-route-id="@Model.CustomerId" class="btn btn-outline-primary rounded-pill">Edit</a>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">← Back to List</a>
            </div>
        </div>
    </div>
</div>
