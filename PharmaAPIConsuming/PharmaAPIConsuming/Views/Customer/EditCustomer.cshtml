@model PharmaAPIConsuming.DTO.CustomerDTO

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow rounded-4 border-0">
                <div class="card-header bg-warning text-dark rounded-top-4">
                    <h3 class="mb-0 text-center">Edit Customer</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="EditCustomer">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="CustomerId" class="form-label fw-semibold">Customer ID</label>
                            <input asp-for="CustomerId" class="form-control" readonly />
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold">Customer Name</label>
                            <input asp-for="Name" class="form-control" placeholder="Full name" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Mobile" class="form-label fw-semibold">Mobile Number</label>
                            <input asp-for="Mobile" class="form-control" placeholder="10-digit mobile" />
                            <span asp-validation-for="Mobile" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label fw-semibold">Address</label>
                            <input asp-for="Address" class="form-control" placeholder="Residential address" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <input type="submit" value="Save Changes" class="btn btn-warning btn-lg rounded-pill text-dark" />
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">← Back to Customer List</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
